---
/**
 * Standard inner page: SEO, breadcrumb trail (visible + structured data),
 * page header and a closing call to action.
 */
import BaseLayout from './BaseLayout.astro';
import PageHeader, { type Crumb } from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { breadcrumbSchema } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  heading?: string;
  intro?: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  cta?: false | { heading?: string; body?: string; primaryLabel?: string; primaryHref?: string; topic?: string };
  type?: 'website' | 'article';
  publishedTime?: string;
}
const { title, description, heading = title, intro, crumbs = [], jsonLd = [], noindex, cta = {}, type, publishedTime } = Astro.props;
const trail = crumbs.length ? [{ label: 'Home', href: '/' }, ...crumbs] : [];
const schemas = trail.length > 1 ? [breadcrumbSchema(Astro.site!, trail), ...jsonLd] : jsonLd;
---
<BaseLayout title={title} description={description} jsonLd={schemas} noindex={noindex} type={type} publishedTime={publishedTime}>
  <PageHeader heading={heading} intro={intro} crumbs={trail}>
    <slot name="header" />
  </PageHeader>
  <slot />
  {cta !== false && <CtaBand {...cta} />}
</BaseLayout>
