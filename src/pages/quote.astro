---
import PageLayout from '@/layouts/PageLayout.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import Icon from '@/components/Icon.astro';
import { site, whatsappLink } from '@/config/site';

const wa = whatsappLink('a project');
---
<PageLayout
  title="Request a quote"
  description="Tell Ilelah Technologies about your project. We reply with questions and a suggested approach, then a written quote once the scope is clear."
  heading="Request a quote"
  intro="Tell us what you need in your own words. The more we understand about the problem, the more useful our reply will be."
  crumbs={[{ label: 'Request a quote', href: '/quote/' }]}
  cta={false}
>
  <section class="section">
    <div class="container quote-grid">
      <div class="form-col">
        <EnquiryForm variant="quote" />
      </div>
      <aside class="aside stack-l" aria-label="What happens next">
        <div class="stack">
          <h2 class="aside__title">What happens next</h2>
          <ol class="next" role="list">
            <li><strong>We read your request</strong> and reply using your preferred contact method.</li>
            <li><strong>We ask questions</strong> to understand the scope, and may suggest a short call.</li>
            <li><strong>You receive a written quote</strong> setting out what is included, the price and the timeline.</li>
            <li><strong>You decide.</strong> Nothing goes ahead until you accept the quote.</li>
          </ol>
        </div>
        <div class="stack">
          <h2 class="aside__title">Prefer to talk?</h2>
          <ul class="direct" role="list">
            <li><a href={`tel:${site.contact.phone}`} data-track="phone_click"><Icon name="call" size={18} /> {site.contact.phoneDisplay}</a></li>
            {wa && <li><a href={wa} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="chat" size={18} /> WhatsApp<span class="visually-hidden"> (opens WhatsApp)</span></a></li>}
            <li><a href={`mailto:${site.contact.email}`} data-track="email_click"><Icon name="mail" size={18} /> {site.contact.email}</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  .quote-grid {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 64rem) {
    .quote-grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
    .aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .form-col {
    max-width: 46rem;
  }
  .aside {
    padding: var(--s-6);
    background: var(--mist);
    border-radius: var(--radius-l);
  }
  .aside__title {
    font-size: var(--step-1);
  }
  .next {
    display: grid;
    gap: var(--s-3);
    counter-reset: n;
  }
  .next li {
    counter-increment: n;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    color: var(--ink-soft);
  }
  .next li::before {
    content: counter(n);
    font-weight: 760;
    color: var(--gold-ink);
  }
  .next strong {
    color: var(--ink);
  }
  .direct {
    display: grid;
    gap: var(--s-2);
  }
  .direct a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
