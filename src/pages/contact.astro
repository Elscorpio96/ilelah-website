---
import PageLayout from '@/layouts/PageLayout.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import Icon from '@/components/Icon.astro';
import { site, whatsappLink, activeSocialLinks } from '@/config/site';

const wa = whatsappLink();
const socials = activeSocialLinks();
---
<PageLayout
  title="Contact us"
  description="Contact Ilelah Technologies by phone, WhatsApp, email or the enquiry form. Based in Bauchi, Nigeria."
  heading="Contact us"
  intro="Ask a question, arrange a conversation or tell us about a problem. Use whichever channel suits you."
  crumbs={[{ label: 'Contact', href: '/contact/' }]}
  cta={false}
>
  <section class="section">
    <div class="container contact-grid">
      <aside class="channels" aria-labelledby="direct-heading">
        <h2 id="direct-heading" class="channels__title">Reach us directly</h2>
        <ul class="channel-list" role="list">
          <li>
            <span class="ch-icon"><Icon name="call" /></span>
            <div><p class="ch-label">Phone</p><a href={`tel:${site.contact.phone}`} data-track="phone_click">{site.contact.phoneDisplay}</a></div>
          </li>
          {wa && (
            <li>
              <span class="ch-icon"><Icon name="chat" /></span>
              <div><p class="ch-label">WhatsApp</p><a href={wa} target="_blank" rel="noopener" data-track="whatsapp_click">Message us on WhatsApp<span class="visually-hidden"> (opens WhatsApp)</span></a></div>
            </li>
          )}
          <li>
            <span class="ch-icon"><Icon name="mail" /></span>
            <div><p class="ch-label">Email</p><a href={`mailto:${site.contact.email}`} data-track="email_click">{site.contact.email}</a></div>
          </li>
          <li>
            <span class="ch-icon"><Icon name="pin" /></span>
            <div><p class="ch-label">Location</p><p>{site.location.display}</p><p class="fine">Meetings are by appointment.</p></div>
          </li>
        </ul>
        {socials.length > 0 && (
          <p class="socials">{socials.map((s) => <a href={s.href} target="_blank" rel="noopener me">{s.label}</a>)}</p>
        )}
        <div class="notice">
          <p><strong>Starting a project?</strong> The <a href="/quote/">quote request form</a> asks the questions that help us prepare a useful reply.</p>
        </div>
      </aside>

      <div class="form-col">
        <h2 class="form-title">Send us a message</h2>
        <EnquiryForm variant="contact" />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 22rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .channels {
    display: grid;
    gap: var(--s-5);
  }
  .channels__title,
  .form-title {
    font-size: var(--step-2);
  }
  .form-title {
    margin-bottom: var(--s-5);
  }
  .form-col {
    max-width: 46rem;
  }
  .channel-list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .channel-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .ch-icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-m);
    background: var(--navy-tint);
    color: var(--navy);
  }
  .ch-label {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .channel-list a {
    font-weight: 640;
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
</style>
