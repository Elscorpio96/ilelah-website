---
import PageLayout from '@/layouts/PageLayout.astro';
import ReviewNote from '@/components/ReviewNote.astro';
import { site } from '@/config/site';

const entity = site.legalEntity ?? site.name;
const LAST_UPDATED = '21 October 2026';
---
<PageLayout
  title="Terms of use"
  description="The terms that apply when you use the Ilelah Technologies website."
  heading="Terms of use"
  intro="The terms that apply when you use this website."
  crumbs={[{ label: 'Terms of use', href: '/terms/' }]}
  cta={false}
>
  <section class="section">
    <div class="container">
      <div class="prose">
        <p class="fine">Last updated: {LAST_UPDATED}</p>
        <ReviewNote>Draft website terms. Have them reviewed by a qualified legal professional before launch, and confirm the legal entity name and governing law.</ReviewNote>

        <h2>About these terms</h2>
        <p>
          This website is operated by {entity}. By using it, you agree to these terms. If you do not agree, please do not
          use the website. These terms cover use of the website only. Any work we carry out for you is governed by a
          separate written quote or agreement.
        </p>

        <h2>Information on this website</h2>
        <p>
          We aim to keep the information on this website accurate and up to date, but it is provided for general
          information only. Descriptions of services, products, courses and features may change.
        </p>
        <p>
          Prices shown on this website are indicative. They are not an offer that can be accepted online. The price,
          scope and terms of any product, service or course are confirmed in writing before you pay. This website does not
          take payments.
        </p>
        <p>Courses described on this website are practical skills training and are not accredited qualifications.</p>

        <h2>Acceptable use</h2>
        <p>You agree not to:</p>
        <ul>
          <li>use the website for anything unlawful, fraudulent or harmful</li>
          <li>submit false information, spam or content that is abusive or infringes anyone's rights through our forms</li>
          <li>try to gain unauthorised access to the website, its server functions or any connected system</li>
          <li>interfere with the website's operation, including by automated or excessive requests</li>
          <li>copy or scrape the website's content for commercial use without permission</li>
        </ul>

        <h2>Intellectual property</h2>
        <p>
          The {site.name} name, logo and the content and design of this website belong to {entity} unless stated
          otherwise. You may view and print pages for your own reference. You may not reproduce, adapt or distribute them
          for commercial purposes without our written permission. Other product and company names mentioned belong to
          their respective owners.
        </p>

        <h2>Links to other websites</h2>
        <p>
          This website may link to websites run by others. We are not responsible for their content, availability or
          privacy practices. A link does not mean we endorse the other website.
        </p>

        <h2>Availability</h2>
        <p>We do not guarantee that the website will always be available or free of errors, and we may change or withdraw any part of it.</p>

        <h2>Limitation of liability</h2>
        <p>
          To the extent permitted by law, we are not liable for any loss arising from your use of, or reliance on, this
          website or its content. Nothing in these terms limits liability that cannot be limited by law.
        </p>

        <h2>Privacy</h2>
        <p>Our <a href="/privacy/">privacy policy</a> explains how we handle personal information submitted through this website.</p>

        <h2>Governing law</h2>
        <p>These terms are governed by the laws of the Federal Republic of Nigeria.</p>

        <h2>Changes to these terms</h2>
        <p>We may update these terms from time to time. The date at the top shows when they were last updated.</p>

        <h2>Contact</h2>
        <p>
          Questions about these terms can be sent to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
