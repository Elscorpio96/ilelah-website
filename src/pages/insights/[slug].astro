---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { site } from '@/config/site';
import { articleSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => site.showDrafts || !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/insights/${entry.id}/`;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' });
const iso = (x: Date) => x.toISOString().slice(0, 10);
---
<PageLayout
  title={d.title}
  description={d.description}
  intro={d.summary}
  type="article"
  publishedTime={iso(d.published)}
  crumbs={[{ label: 'Insights', href: '/insights/' }, { label: d.title, href: path }]}
  jsonLd={[articleSchema(Astro.site!, { title: d.title, description: d.description, path, published: d.published, updated: d.updated, author: d.author })]}
>
  <p slot="header" class="byline">
    By {d.author}, {site.founder.name === d.author ? `${site.founder.role}, ` : ''}{site.name}.
    Published <time datetime={iso(d.published)}>{fmt.format(d.published)}</time>{d.updated && <>. Updated <time datetime={iso(d.updated)}>{fmt.format(d.updated)}</time></>}.
  </p>
  <article class="section">
    <div class="container">
      <div class="prose article">
        <Content />
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .byline {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .article {
    font-size: 1.125rem;
  }
</style>
