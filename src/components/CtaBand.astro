---
import { whatsappLink } from '@/config/site';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  topic?: string;
}
const {
  heading = 'Tell us what you need to fix or build',
  body = 'Describe the problem in your own words. We reply with questions and a suggested approach, then a written quote once the scope is clear.',
  primaryLabel = 'Request a quote',
  primaryHref = '/quote/',
  topic,
} = Astro.props;
const wa = whatsappLink(topic);
---
<section class="section section--navy cta-band">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href={primaryHref}>{primaryLabel}</a>
      {wa && (
        <a class="btn btn--on-navy" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click">
          <Icon name="chat" /> Chat on WhatsApp<span class="visually-hidden"> (opens WhatsApp)</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-inner {
    display: grid;
    gap: var(--s-6);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-8);
    }
  }
  .cta-copy {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
  }
  .cta-copy h2 {
    font-size: var(--step-4);
  }
  .cta-copy p {
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
