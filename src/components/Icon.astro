  chart: '<path d="M4 4v16h16"/><path d="M8 15l3.5-4 3 2.5L19 8"/>',
  users: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><path d="M15.5 5.6a3.2 3.2 0 0 1 0 5.8M18 14.8c1.6.8 2.7 2.5 3 4.7"/>',
  offline: '<path d="M3 3l18 18"/><path d="M8.5 16.5a5 5 0 0 1 7 0M5.3 13.2a9.5 9.5 0 0 1 4-2.4M14.5 10.8a9.5 9.5 0 0 1 4.2 2.4M2 9.8a14 14 0 0 1 4-2.6M11 6.1A14 14 0 0 1 22 9.8"/><circle cx="12" cy="19.5" r="0.6" fill="currentColor"/>',
