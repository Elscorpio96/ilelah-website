---
/**
 * Small, hand-drawn line icon set (24px grid, 1.75 stroke).
 * Icons are decorative by default (aria-hidden). Pass `label` to expose one to screen readers.
 */
import type { IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
