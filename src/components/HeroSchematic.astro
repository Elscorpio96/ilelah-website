---
/**
 * The homepage's signature element: a schematic in which the Ilelah node
 * connects by circuit traces to each division. Drawn once on load; static
 * for visitors who prefer reduced motion. Decorative: the same information
 * is given as text and links on the page.
 */
const nodes = [
  { label: 'Software', x: 92, y: 64, d: 'M236 196 H168 V64 H100' },
  { label: 'Business Suite', x: 468, y: 64, d: 'M324 196 H392 V64 H460' },
  { label: 'EduTech', x: 60, y: 220, d: 'M236 220 H68' },
  { label: 'ICT Services', x: 500, y: 220, d: 'M324 220 H492' },
  { label: 'Creative', x: 92, y: 376, d: 'M236 244 H168 V376 H100' },
  { label: 'Academy', x: 468, y: 376, d: 'M324 244 H392 V376 H460' },
];
---
<svg class="schematic" viewBox="0 0 560 440" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- faint engineering grid -->
  <defs>
    <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0V24" fill="none" stroke="var(--line)" stroke-width="0.75" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="560" height="440" fill="url(#grid)" class="grid" />

  {nodes.map((n, i) => (
    <g class="branch" style={`--i:${i}`}>
      <path class="trace" d={n.d} pathLength="1" />
      <rect class="node" x={n.x - 7} y={n.y - 7} width="14" height="14" transform={`rotate(45 ${n.x} ${n.y})`} />
      <text class="label" x={n.x} y={n.y - 20} text-anchor="middle">{n.label}</text>
    </g>
  ))}

  <!-- hub: the Ilelah mark -->
  <g class="hub">
    <rect x="236" y="176" width="88" height="88" rx="18" fill="var(--navy)" />
    <rect x="272" y="213" width="16.5" height="34" rx="2" fill="#fff" />
    <path d="M280 191.3 L288.75 200.06 L280 208.8 L271.25 200.06 Z" fill="var(--gold)" />
  </g>
</svg>

<style>
  .schematic {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid {
    opacity: 0.7;
  }
  .trace {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.75;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .node {
    fill: var(--gold);
  }
  .label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 620;
    fill: var(--navy);
    letter-spacing: -0.01em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trace {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 900ms var(--ease) forwards;
      animation-delay: calc(250ms + var(--i) * 90ms);
    }
    .node,
    .label {
      opacity: 0;
      animation: appear 400ms var(--ease) forwards;
      animation-delay: calc(900ms + var(--i) * 90ms);
    }
    .hub {
      transform-origin: 280px 220px;
      animation: settle 500ms var(--ease) both;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @keyframes settle {
    from {
      transform: scale(0.92);
      opacity: 0;
    }
  }
</style>
