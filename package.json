{
  "name": "ilelah-website",
  "version": "1.0.0",
  "description": "Ilelah Technologies corporate website (Astro static site + Cloudflare Pages Function for enquiries)",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc -p functions/tsconfig.json",
    "build": "npm run check && astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --port 4321",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "brand": "python3 scripts/brand/build_brand.py",
    "pages:dev": "wrangler pages dev dist --port 8788 --compatibility-date=2026-10-01"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "@playwright/test": "1.56.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  }
}
