# ---------------------------------------------------------------------------
# PUBLIC build settings for the Ilelah Technologies website.
# These are read at BUILD time and end up in the public HTML, so only put
# values here that are safe for anyone to see.
#
# Local use: copy this file to `.env` and edit. In Cloudflare Pages, set them
# under Settings > Environment variables (Production and Preview separately).
# See docs/ENVIRONMENT_SETUP.md.
# ---------------------------------------------------------------------------

# The single canonical address of the site (no trailing slash).
PUBLIC_SITE_URL=https://www.ilelahtech.com

# Search engines are blocked unless this is exactly "true".
# Set to true ONLY on the verified production deployment.
PUBLIC_ALLOW_INDEXING=false

# Cloudflare Turnstile SITE key (public by design). Leave empty to hide the widget.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token (public by design). Leave empty to keep analytics off.
PUBLIC_CF_ANALYTICS_TOKEN=
